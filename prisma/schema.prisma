generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id // Clerk User ID
  updatedAt DateTime @updatedAt
  username  String?  @unique
  fullName  String?
  avatarUrl String?

  // Intake Data
  sex                String?
  goal               String?
  currentWeight      Float?
  targetWeight       Float?
  trainingExperience String?
  trainingDays       Int?
  musclePriority     String? @default("balanced")

  // Nutrition Targets
  targetCalories Int?
  targetProtein  Int?

  // Relations
  workoutLogs       WorkoutLog[]
  nutritionLogs     NutritionLog[]
  progressPhotos    ProgressPhoto[]
  applications      CoachingApplication[]
  mealEntries       MealEntry[]
  weightEntries     WeightEntry[]
  workoutSessions   WorkoutSession[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityLikes    CommunityLike[]
  communityReports  CommunityReport[]
  customFoods       CustomFood[]
  pantry            MemberPantry?

  @@map("profiles")
}

model CoachingApplication {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  userId      String
  fullName    String
  email       String
  currentGoal String
  experience  String
  message     String
  status      String   @default("pending") // pending, approved, rejected

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coaching_applications")
}

model Exercise {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  name         String   @unique
  muscleGroup  String
  equipment    String?
  instructions String?
  isActive     Boolean  @default(true)

  workoutTemplates WorkoutTemplate[]
  workoutLogs      WorkoutLog[]

  @@map("exercises")
}

model WorkoutTemplate {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  templateName String
  dayNumber    Int
  orderIndex   Int
  defaultSets  Int
  defaultReps  String
  notes        String?

  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId String

  @@map("workout_templates")
}

model WorkoutLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  userId      String
  exerciseId  String
  weight      Float?
  reps        Int?
  setNumber   Int
  workoutDate DateTime @default(now())
  isCompleted Boolean  @default(false)

  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@map("workout_logs")
}

model NutritionLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  logDate   DateTime @default(now())
  calories  Int?
  protein   Int?

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logDate])
  @@map("nutrition_logs")
}

model ProgressPhoto {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  url       String
  label     String?

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_photos")
}

model MealEntry {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  userId      String
  logDate     DateTime @db.Date
  name        String
  mealType    String
  portion     String?
  calories    Int
  protein     Float    @default(0)
  carbs       Float    @default(0)
  fat         Float    @default(0)
  ingredients Json?
  profile     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, logDate])
  @@map("meal_entries")
}

model WeightEntry {
  id       String   @id @default(uuid())
  userId   String
  logDate  DateTime @db.Date
  weightLb Float
  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logDate])
  @@map("weight_entries")
}

model WorkoutSession {
  id          String   @id @default(uuid())
  userId      String
  workoutDate DateTime
  planKey     String
  dayNumber   Int
  title       String
  isCompleted Boolean  @default(false)
  effort      String?
  profile     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutDate])
  @@index([userId, planKey, workoutDate])
  @@map("workout_sessions")
}

model CommunityPost {
  id         String             @id @default(uuid())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  userId     String
  authorName String
  body       String
  category   String
  profile    Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   CommunityComment[]
  likes      CommunityLike[]
  reports    CommunityReport[]

  @@index([createdAt, id])
  @@index([userId, createdAt])
  @@map("community_posts")
}

model CommunityComment {
  id         String        @id @default(uuid())
  createdAt  DateTime      @default(now())
  userId     String
  postId     String
  authorName String
  body       String
  profile    Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@map("community_comments")
}

model CommunityLike {
  userId  String
  postId  String
  profile Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("community_likes")
}

model CommunityReport {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  userId    String
  postId    String
  reason    String
  profile   Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([createdAt])
  @@map("community_reports")
}

model CustomFood {
  id             String   @id @default(uuid())
  userId         String
  createdAt      DateTime @default(now())
  name           String
  brand          String?
  preparation    String
  role           String
  diet           String
  calories       Float
  protein        Float
  carbs          Float
  fat            Float
  allergens      String[]
  labelReviewed  Boolean  @default(false)
  reference      String
  servingGrams   Float?
  referenceBasis String   @default("serving")
  profile        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("custom_foods")
}

model MemberPantry {
  userId      String   @id
  updatedAt   DateTime @updatedAt
  foodIds     String[]
  preferences Json
  profile     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_pantries")
}
