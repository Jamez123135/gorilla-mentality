{
  "name": "gorilla-mentality",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "npm run ocr:assets && next dev",
    "build": "npm run ocr:assets && prisma generate && npm run db:deploy && next build",
    "ocr:assets": "node scripts/prepare-ocr-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prisma:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-database.ts",
    "db:deploy": "node scripts/deploy-database.mjs",
    "db:local": "node scripts/local-database.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.14",
    "@clerk/shared": "4.40.0",
    "@prisma/client": "5.22.0",
    "framer-motion": "^12.29.2",
    "fuse.js": "^7.5.0",
    "image-size": "^2.0.4",
    "lucide-react": "^0.563.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-image-crop": "^11.0.10",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@clerk/backend": "3.23.2",
    "@clerk/testing": "^2.2.45",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
